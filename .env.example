# Copy to .env and fill in. All EXPO_PUBLIC_* values are bundled into the app (not secret).

# --- Firebase web app config (Project settings → General → Your apps → Web app) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Emulator Suite (development). true = connect Auth + RTDB to local emulators ---
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# Optional: override emulator host (defaults to the Metro dev server host; 10.0.2.2 on Android emulator)
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# --- Google sign-in (Authentication → Google → Web client ID; iOS = CLIENT_ID in GoogleService-Info.plist) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client id (REVERSED_CLIENT_ID in GoogleService-Info.plist), used by the config plugin URL scheme
GOOGLE_IOS_URL_SCHEME=

# --- Google Maps (build-time; not bundled into JS). Google Maps is used on BOTH platforms. ---
# Restrict each key to its platform (Android: package + SHA-1; iOS: bundle id).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# --- Seed / admin scripts (local only) ---
SEED_CENTER_LAT=24.8607
SEED_CENTER_LNG=67.0011
